# Supabase (cloud)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Local development (after `pnpm db:start`) ---
# Generate automatically with: pnpm db:env
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<see pnpm db:status>
# SUPABASE_SERVICE_ROLE_KEY=<see pnpm db:status>

# OAuth providers (set to "true" to show the button in auth forms)
# Enable only after the provider is configured in Supabase for this environment.
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_OAUTH_GITHUB_ENABLED=false

# App URL (used for OAuth and email redirects)
# Required in staging/production: must be a valid HTTPS URL (no localhost fallback).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Maintenance mode toggle (set to "true" to lock site to maintenance view)
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Legal operator details (used when seeding/publishing legal documents)
# See docs/legal/operator-config.md
LEGAL_OPERATOR_NAME=English Pathway
LEGAL_PRIVACY_CONTACT_EMAIL=privacy@your-domain.com
LEGAL_SUPPORT_CONTACT_EMAIL=support@your-domain.com
LEGAL_GOVERNING_JURISDICTION=your jurisdiction

# OAuth inspection scripts (optional — production example)
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_ACCESS_TOKEN=your-management-api-token
# OAUTH_EXTRA_ALLOWLIST=http://localhost:3000/**

# Server-only secret for signed OAuth registration consent cookies (min 32 chars)
AUTH_COOKIE_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Local OAuth provider credentials (optional — never commit real values)
# Required when enabling [auth.external.*] in supabase/config.toml for local dev.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# OpenAI — embeddings for RAG knowledge base (pnpm kb:embed)
OPENAI_API_KEY=
# This key is server-only and is also used by the English chat assistant and OpenAI voice fallback.
# Never expose it with a NEXT_PUBLIC_ prefix.

# ElevenLabs — voice tutor on /learn
ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# OpenAI realtime voice fallback (used when ElevenLabs is not configured)
# Default model: gpt-realtime-2.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin

# In Supabase Dashboard → Auth → URL Configuration, also allowlist:
#   {NEXT_PUBLIC_APP_URL}/**
# See docs/operations/oauth-setup.md for per-environment setup.
