# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/learn
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Supabase (Database & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Local development (after `pnpm db:start`) ---
# Generate automatically with: pnpm db:env
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<see pnpm db:status>
# SUPABASE_SERVICE_ROLE_KEY=<see pnpm db:status>

# App URL (used for app routing and canonical URLs)
# Required in staging/production: must be a valid HTTPS URL (no localhost fallback).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Maintenance mode toggle (set to "true" to lock site to maintenance view)
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Legal operator details (used when seeding/publishing legal documents)
# See docs/legal/operator-config.md
LEGAL_OPERATOR_NAME=English Pathway
LEGAL_PRIVACY_CONTACT_EMAIL=privacy@your-domain.com
LEGAL_SUPPORT_CONTACT_EMAIL=support@your-domain.com
LEGAL_GOVERNING_JURISDICTION=your jurisdiction

# OpenAI — embeddings for RAG knowledge base (pnpm kb:embed)
OPENAI_API_KEY=
# This key is server-only and is also used by the English chat assistant and OpenAI voice fallback.
# Never expose it with a NEXT_PUBLIC_ prefix.

# ElevenLabs — voice tutor on /learn
ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# OpenAI realtime voice fallback (used when ElevenLabs is not configured)
# Default model: gpt-realtime-2.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
